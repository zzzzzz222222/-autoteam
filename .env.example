# AutoTeam environment configuration.
#
# Everything is OPTIONAL. With nothing set, AutoTeam runs fully offline:
#   - rule-based task analysis
#   - deterministic MockLLMProvider
#   - offline_mock web search (real URLs are never fabricated)
#
# No API key is required to run any demo or test.

# ---------------------------------------------------------------------------
# Real LLM (v0.5.0) — OpenAI / DeepSeek compatible provider
# `get_llm_provider()` reads these. If no key is present it returns the mock.
# ---------------------------------------------------------------------------
# AUTOTEAM_LLM_PROVIDER=deepseek     # deepseek | openai | mock (default mock)
# AUTOTEAM_API_KEY=
# AUTOTEAM_LLM_MODEL=deepseek-chat
# AUTOTEAM_LLM_BASE_URL=https://api.deepseek.com/v1

# Real Web Search (v0.5.0) — Tavily-compatible HTTP JSON search API.
# With both URL and key set, web_search performs a real HTTPS POST
# (JSON body {"query": ...}, Authorization: Bearer, timeout, response
# validation, degradation to offline on failure). The key is never logged.
# AUTOTEAM_WEB_SEARCH_URL=https://api.tavily.com/search
# AUTOTEAM_WEB_SEARCH_API_KEY=

# Local Knowledge workspace (v0.5.0) — directory the `local_knowledge` tool
# may read (.md/.txt/.json/.csv). Defaults to ./knowledge.
# AUTOTEAM_WORKSPACE_DIR=

# ---------------------------------------------------------------------------
# Legacy analyzer config (v0.1.x path) — used by the rule-based task analyzer
# to optionally call an OpenAI-compatible LLM instead of keyword rules.
# ---------------------------------------------------------------------------
# LLM_API_KEY=            # leave empty to stay offline
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LOG_LEVEL=INFO