# AutoTeam runs fully offline with the rule-based analyzer.
# Every variable below is OPTIONAL and only used when you want the analyzer to
# call an OpenAI-compatible LLM instead of the deterministic keyword rules.

# LLM_API_KEY=            # leave empty to stay offline
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LOG_LEVEL=INFO
